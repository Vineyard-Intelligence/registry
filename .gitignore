__pycache__/
*.pyc

# The full ecosystem spec, kept beside the schemas it describes but NOT published.
#
# It is a working contract, not author documentation: parts of it describe design that is
# deliberately "deferred — not built yet" (see the notes at §5 and the web-proxy origin), and
# registry/ is a GitHub Pages site, so committing it would serve unbuilt features to pack authors
# as though they existed. The published SPEC.md beside it covers only what the registry actually
# does today; the author-facing version of the rest is documentation/docs/develop/.
SPEC_INTERNAL.md
.DS_Store

# Local tool venv (validate.py needs jsonschema). Never publish — this is a Pages site,
# and the venv's absolute symlinks are what makes the artifact upload fail.
.venv/
